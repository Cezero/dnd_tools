generator client {
  provider = "prisma-client-js"
  output   = "../../../packages/shared/prisma-client/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =================
// Class related
// =================

model Class {
  id            Int     @id @default(autoincrement())
  name          String
  abbreviation  String
  editionId     Int
  isPrestige    Boolean @default(false)
  isVisible     Boolean @default(true)
  canCastSpells Boolean @default(false)
  spellsKnown   Boolean @default(false)
  isDivine      Boolean @default(false)
  description   String? @db.Text

  sharedFeatures FeatureClassMap[] // Many-to-many relationship for reusable features
  sourceBookInfo            ClassSourceMap[]
  spellLevels               SpellLevelMap[]
  charAdvancements          CharacterAdvancement[]
  charAdvSecondary          CharacterAdvancement[]       @relation("SecondaryClass")
  charSpellPrep             CharacterSpellPreparation[]
  deityClasses              DeityClassMap[]
}

model SpellcastingProgression {
  id                 Int  @id @default(autoincrement())
  classLevel         Int

  // Link via Feature
  featureId      Int? @unique // Links to Feature that grants this casting
  spellcastingType Int? // Enum: SpellsPerDay (1), SpellsKnown (2)

  slots            SpellcastingSlot[]
  spellcastingLink SpellcastingLink[]
}

model SpellcastingSlot {
  id            Int @id @default(autoincrement())
  progressionId Int
  spellLevel    Int
  slotsPerDay   Int

  progression SpellcastingProgression @relation(fields: [progressionId], references: [id])
}

model SpellcastingLink {
  id            Int     @id @default(autoincrement())
  featureId     Int     @unique
  progressionId Int
  inheritedFrom String?
  levelOffset   Int?

  feature     Feature                @relation(fields: [featureId], references: [id])
  progression SpellcastingProgression @relation(fields: [progressionId], references: [id])
}

model ClassSourceMap {
  classId      Int
  pageNumber   Int?
  sourceBookId Int

  class      Class       @relation(fields: [classId], references: [id])
  sourceBook SourceBook? @relation(fields: [sourceBookId], references: [id])

  @@id([classId, sourceBookId])
}

model SpellLevelMap {
  classId   Int
  spellId   Int
  level     Int
  isVisible Boolean @default(true)

  spell Spell @relation(fields: [spellId], references: [id])
  class Class @relation(fields: [classId], references: [id])

  @@id([spellId, classId])
}

// =================
// Feature related
// =================

model Feature {
  id                      Int     @id @default(autoincrement())
  slug                    String  @unique
  name                    String
  description             String  @db.Text
  summary                 String? @db.Text // Can contain template placeholders {{placeholder}}
  displayInCharacterSheet Boolean @default(true)
  
  // Fields from FeatureProgression (merged)
  sourceType  Int
  level       Int
  domainId    Int? // Reference to domain for domain-granted features
  featId      Int? // Reference to Feat (same pattern as domainId)
  companionId Int? // Reference to Companion for companion-granted features
  editionId   Int? // Reference to edition for edition-granted features

  // Relationships from FeatureProgression
  domain    Domain?    @relation(fields: [domainId], references: [id]) // Domain relationship
  feat      Feat?      @relation(fields: [featId], references: [id]) // Feat relationship
  companion Companion? @relation(fields: [companionId], references: [id]) // Companion relationship

  // Many-to-many relationship for reusable features
  classes FeatureClassMap[]
  races   FeatureRaceMap[]

  // Relationships
  prerequisites       FeaturePrerequisite[]
  transformationForms    TransformationFormEligibility[]
  spellcasting           SpellcastingLink?
  characterFeatureChoice CharacterFeatureChoice[]
  entities               FeatureEntity[]
  displayConditions      FeatureCondition[]
  characterFeatureUses   CharacterFeatureUses[]
  selectedForms          CharacterSelectedForm[]

  @@index([featId])
  @@index([companionId])
  @@index([editionId])
}

// Junction table for many-to-many class-feature relationship
model FeatureClassMap {
  featureId    Int
  classId      Int
  levelDivisor Int @default(1) // 1 = full class level; 2 = ranger animal companion (half level)

  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([featureId, classId])
  @@index([classId])
  @@index([featureId])
}

// Junction table for many-to-many race-feature relationship
model FeatureRaceMap {
  featureId Int
  raceId    Int

  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  race    Race    @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@id([featureId, raceId])
  @@index([raceId])
  @@index([featureId])
}

model FeatureEntity {
  id              Int     @id @default(autoincrement())
  featureId       Int
  appliesTo       Int
  appliesToId     Int?
  appliesToSubId  Int?
  formulaParamsId Int?
  groupingId      Int     @default(0)
  type            Int
  value           Float? // Can be float for fractional scalingValues (e.g., 0.5, 0.75 for LEVEL_TIMES_VALUE)
  bonusType       Int?
  displayInDetail      Boolean @default(true)
  showFullProgression  Boolean @default(false)
  filterType           Int?

  feature                Feature                  @relation(fields: [featureId], references: [id])
  conditions             FeatureEntityCondition[]
  formulaParams          FeatureFormulaParams?    @relation(fields: [formulaParamsId], references: [id])
  characterFeatureChoice CharacterFeatureChoice[]
  characterFeatureUses   CharacterFeatureUses[]
}

model FeatureFormulaParams {
  id                      Int     @id @default(autoincrement())
  formulaId               Int
  interval                Int?
  formulaStartLevel       Int?
  abilityId               Int?
  thresholds              String?
  values                  String?
  includeProgressionLevel Boolean @default(true)
  featureLevelZero        Boolean @default(false)

  // Enhanced parameters for complex scaling
  valuesRepresent Int? // ConditionalScalingValueType enum
  cumulative      Boolean @default(false) // Whether values accumulate

  // Division-based formula parameters (for LEVEL_DIVIDED_BY and LEVEL_DIVIDED_BY_PLUS_BASE)
  divisor   Int? // Divisor value for floor(level / divisor) formulas
  baseValue Int? // Base value to add for floor(level / divisor) + baseValue formulas

  // Starting value for formulas that need a different starting value than the increment (e.g., EVERY_N_LEVELS)
  startingValue Int? // Starting value (defaults to entity.value if null)

  // Max value / cap for formulas that have an upper bound
  maxValue Int?

  featureEntity FeatureEntity[]
}

model FeatureEntityCondition {
  id              Int @id @default(autoincrement())
  featureEntityId Int
  conditionType   Int
  conditionValue  Int

  featureEntity FeatureEntity @relation(fields: [featureEntityId], references: [id])
}

model FeaturePrerequisite {
  id          Int  @id @default(autoincrement())
  featureId   Int
  type        Int
  appliesToId Int?
  minValue    Int

  feature Feature @relation(fields: [featureId], references: [id])
}

model FeatureCondition {
  id            Int @id @default(autoincrement())
  featureId     Int
  conditionType Int // Reuses FeatureEntityConditionType enum
  conditionValue Int

  feature Feature @relation(fields: [featureId], references: [id])

  @@index([featureId])
}

// =================
// Spell info
// =================

model Spell {
  id              Int     @id @default(autoincrement())
  name            String
  summary         String? @db.Text
  description     String? @db.Text
  castingTime     String?
  range           String?
  rangeTypeId     Int?
  rangeValue      String?
  area            String?
  duration        String?
  savingThrow     String?
  spellResistance String?
  editionId       Int
  isVisible       Boolean @default(true)
  baseLevel       Int
  effect          String?
  target          String?

  descriptorIds  SpellDescriptorMap[]
  levelMapping   SpellLevelMap[]
  schoolIds      SpellSchoolMap[]
  sourceBookInfo SpellSourceMap[]
  subSchoolIds   SpellSubschoolMap[]
  componentIds   SpellComponentMap[]
  advSpells      AdvancementSpell[]
  charSpellPrep  CharacterSpellPreparation[]
  domainSpells   DomainSpell[] // NEW: Domain spell associations
  monsterSpells  MonsterSpell[]
}

model SpellDescriptorMap {
  spellId      Int
  descriptorId Int
  spell        Spell @relation(fields: [spellId], references: [id])

  @@id([spellId, descriptorId])
}

model SpellSchoolMap {
  spellId  Int
  schoolId Int
  spell    Spell @relation(fields: [spellId], references: [id])

  @@id([spellId, schoolId])
}

model SpellSourceMap {
  spellId      Int
  sourceBookId Int
  pageNumber   Int?

  spell      Spell      @relation(fields: [spellId], references: [id])
  sourceBook SourceBook @relation(fields: [sourceBookId], references: [id])

  @@id([spellId, sourceBookId])
}

model SpellSubschoolMap {
  spellId     Int
  subSchoolId Int

  spell Spell @relation(fields: [spellId], references: [id])

  @@id([spellId, subSchoolId])
}

model SpellComponentMap {
  spellId     Int
  componentId Int

  spell Spell @relation(fields: [spellId], references: [id])

  @@id([spellId, componentId])
}

// =================
// Skill Info
// =================

model Skill {
  id                 Int                  @id @default(autoincrement())
  name               String
  abilityId          Int                  @default(1)
  checkDescription   String?              @db.Text
  actionDescription  String?              @db.Text
  retryTypeId        Int?
  retryDescription   String?              @db.Text
  specialNotes       String?              @db.Text
  synergyNotes       String?              @db.Text
  untrainedNotes     String?              @db.Text
  affectedByArmor    Boolean              @default(false)
  description        String?              @db.Text
  restrictionNotes   String?              @db.Text
  trainedOnly        Boolean?
  isAnalog           Boolean              @default(false)
  isVisible          Boolean              @default(true)
  editionId          Int
  hasSubtypes        Boolean              @default(false) // true for Craft, Knowledge
  usesCustomSubtype  Boolean              @default(false) // true for Perform, Profession
  hasNoMaxRanks      Boolean              @default(false) // true for Speak Language (no max rank limit)
  doubleArmorPenalty Boolean              @default(false) // true for Swim (double armor check penalty)
  sourceBookInfo     SkillSourceBookMap[]

  advSkills               AdvancementSkill[]
  monsters                MonsterSkillMap[]
  subtypes                SkillSubtype[]
  characterCompanionSkills CharacterCompanionSkill[]
}

model SkillSourceBookMap {
  skillId      Int
  sourceBookId Int
  pageNumber   Int?

  skill      Skill      @relation(fields: [skillId], references: [id])
  sourceBook SourceBook @relation(fields: [sourceBookId], references: [id])

  @@id([skillId, sourceBookId])
}

model SkillSubtype {
  id        Int     @id @default(autoincrement())
  skillId   Int // References Skill.id
  name      String
  editionId Int
  isVisible Boolean @default(true)

  skill Skill @relation(fields: [skillId], references: [id])

  @@unique([skillId, name, editionId])
  @@index([skillId])
}

// =================
// Feats and related info
// =================

model Feat {
  id             Int                 @id @default(autoincrement())
  name           String
  typeId         Int
  repeatable     Boolean?
  fighterBonus   Boolean?
  useSubId       Boolean             @default(false)
  isVisible      Boolean             @default(true)
  editionId      Int
  sourceBookInfo FeatSourceBookMap[]

  advFeat AdvancementFeat[]

  monsters                   MonsterFeatMap[]
  features                   Feature[]
  characterSpellPreparations CharacterSpellPreparation[]
  characterCompanionFeats    CharacterCompanionFeat[]
}

model FeatSourceBookMap {
  featId       Int
  sourceBookId Int
  pageNumber   Int?

  feat       Feat       @relation(fields: [featId], references: [id])
  sourceBook SourceBook @relation(fields: [sourceBookId], references: [id])

  @@id([featId, sourceBookId])
}

// =================
// Race and related info
// =================

model Race {
  id          Int     @id @default(autoincrement())
  name        String
  editionId   Int
  isVisible   Boolean @default(true)
  description String? @db.Text

  sourceBookInfo            RaceSourceMap[]
  characters                Character[]
  sharedFeatures            FeatureRaceMap[] // Many-to-many relationship for reusable features
  deityRaces                DeityRaceMap[]
}

model RaceSourceMap {
  raceId       Int
  sourceBookId Int
  pageNumber   Int?

  race       Race        @relation(fields: [raceId], references: [id])
  sourceBook SourceBook? @relation(fields: [sourceBookId], references: [id])

  @@id([raceId, sourceBookId])
}

// =================
// Mundane Armor, Weapons etc.
// =================

model Item {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String?  @db.Text
  typeId      Int      @default(1)
  cost        Decimal? @db.Decimal(10, 2)
  weight      Decimal? @db.Decimal(5, 2)
  quantity    Int?
  sizeId      Int? // Size ID (defaults to Medium = 5 in application layer)

  armor  Armor?
  weapon Weapon?

  itemType ItemType @relation(fields: [typeId], references: [id])

  characterItems        CharacterItem[]
  itemTemplate          ItemTemplate[]
  deityFavoredWeapons   DeityFavoredWeaponMap[]
  monsterArmorBreakdown MonsterArmorBreakdown[]
  monsterEquipment      MonsterEquipment[]
}

model ItemType {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(100)

  itemLinks Item[]
}

model Armor {
  id                 Int  @id
  category           Int
  bonus              Int?
  dexterityCap       Int?
  checkPenalty       Int?
  arcaneSpellFailure Int?
  speedCapThirty     Int?
  speedCapTwenty     Int?

  item Item @relation(fields: [id], references: [id], onDelete: Cascade)
}

model Weapon {
  id           Int     @id
  category     Int
  type         Int
  attackBonus  Int?
  damageSmall  String?
  damageMedium String?
  critical     String?
  range        String?
  damageType   String?
  reach        Boolean @default(false)
  double       Boolean @default(false)
  nonlethal    Boolean @default(false)

  item Item @relation(fields: [id], references: [id], onDelete: Cascade)
}

model ItemProperty {
  id                      Int              @id @default(autoincrement())
  name                    String           @db.VarChar(100) // e.g. "Vorpal", "+2 Enhancement"
  type                    ItemPropertyType
  flatCostModifier        Int? // in copper
  costMultiplier          Float? // e.g. 2.0 for Barding
  costFormula             String? // optional expression string
  enhancementBonusValue   Int? // e.g. 2 for "+2"
  bonusEquivalentModifier Int? // e.g. 5 for Vorpal
  exclusiveMaterial       Boolean          @default(false)

  appliesTo               ItemPropertyAppliesTo[]
  incompatibilitiesA      ItemPropertyIncompatibility[] @relation("IncompatibilityA")
  incompatibilitiesB      ItemPropertyIncompatibility[] @relation("IncompatibilityB")
  templateProperties      ItemTemplateProperty[]
  characterItemProperties CharacterItemProperty[]
}

enum ItemPropertyType {
  Material
  Enhancement
  SpecialAbility
  Structural
}

model ItemPropertyAppliesTo {
  id         Int                    @id @default(autoincrement())
  property   ItemProperty           @relation(fields: [propertyId], references: [id])
  propertyId Int
  itemType   ItemApplicableTypeEnum
}

enum ItemApplicableTypeEnum {
  Weapon
  Armor
  Shield
  MountArmor
  Ammunition
}

model ItemPropertyIncompatibility {
  id          Int          @id @default(autoincrement())
  propertyA   ItemProperty @relation("IncompatibilityA", fields: [propertyAId], references: [id])
  propertyAId Int
  propertyB   ItemProperty @relation("IncompatibilityB", fields: [propertyBId], references: [id])
  propertyBId Int
}

model ItemTemplate {
  id     Int    @id @default(autoincrement())
  name   String @db.VarChar(100)
  itemId Int

  item Item @relation(fields: [itemId], references: [id])

  templateProperties ItemTemplateProperty[]
}

model ItemTemplateProperty {
  id         Int @id @default(autoincrement())
  templateId Int
  propertyId Int

  template ItemTemplate @relation(fields: [templateId], references: [id])
  property ItemProperty @relation(fields: [propertyId], references: [id])
}

model CharacterItem {
  id          Int    @id @default(autoincrement())
  name        String // e.g. "Vorpal Dragonbane Longsword"
  quantity    Int?
  location    Int? // Location enum value (null/0 = Owned, other values = specific locations)
  characterId Int
  baseItemId  Int

  character Character @relation(fields: [characterId], references: [id])
  baseItem  Item          @relation(fields: [baseItemId], references: [id])

  characterItemProperties CharacterItemProperty[]
  mainHandAttacks         CharacterAttackDefinition[] @relation("MainHandAttacks")
  offHandAttacks          CharacterAttackDefinition[] @relation("OffHandAttacks")
}

model CharacterItemProperty {
  id              Int           @id @default(autoincrement())
  characterItemId Int
  propertyId      Int
  characterItem   CharacterItem @relation(fields: [characterItemId], references: [id])
  property        ItemProperty  @relation(fields: [propertyId], references: [id])
}

model CharacterAttackDefinition {
  id                      Int     @id @default(autoincrement())
  characterId             Int
  attackSlot              Int? // 1-7, nullable for attacks not displayed on sheet
  mainHandCharacterItemId Int? // CharacterItem ID for main hand weapon (nullable)
  offHandCharacterItemId  Int? // CharacterItem ID for off-hand weapon (nullable, only for dual wield)
  /// One-handed melee used in two hands (1.5x STR). Ignored when off-hand is a weapon.
  wieldTwoHanded          Boolean @default(false)

  character    Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  mainHandItem CharacterItem? @relation("MainHandAttacks", fields: [mainHandCharacterItemId], references: [id], onDelete: SetNull)
  offHandItem  CharacterItem? @relation("OffHandAttacks", fields: [offHandCharacterItemId], references: [id], onDelete: SetNull)

  @@index([characterId])
  @@index([attackSlot])
}

// =================
// Source Books
// =================

model SourceBook {
  id           Int       @id @default(autoincrement())
  name         String
  abbreviation String
  releaseDate  DateTime?
  editionId    Int
  description  String?   @db.Text
  isVisible    Boolean   @default(false)
  settingId    Int? // Reference to Setting enum (nullable for books not tied to a setting)
  hasCore      Boolean   @default(false) // Flag indicating core rulebooks (PHB, DMG) for each edition
  hasClasses   Boolean   @default(false) // Flag indicating book contains class options
  hasSpells    Boolean   @default(false) // Flag indicating book contains spells
  hasRaces     Boolean   @default(false) // Flag indicating book contains race options
  hasDomains   Boolean   @default(false) // Flag indicating book contains domain options
  hasDeities   Boolean   @default(false) // Flag indicating book contains deity options
  hasItems     Boolean   @default(false) // Flag indicating book contains item options

  classes                    ClassSourceMap[]
  races                      RaceSourceMap[]
  spells                     SpellSourceMap[]
  domains                    DomainSourceMap[] // NEW: Domain source references
  deities                    DeitySourceMap[] // NEW: Deity source references
  tricks                     TrickSourceMap[] // NEW: Trick source references
  trickPurposes              TrickPurposeSourceMap[]
  characterDisallowedSources CharacterDisallowedSource[] // NEW: Character disallowed sources relationship
  skillSourceBookInfo        SkillSourceBookMap[]
  featSourceBookInfo         FeatSourceBookMap[]
  monsters                   MonsterSourceMap[]
}

// =================
// Reference Tables
// =================

enum TextAlignment {
  left
  center
  right
}

model ReferenceTable {
  slug        String  @id
  name        String
  description String? @db.Text

  columns ReferenceTableColumn[]
  rows    ReferenceTableRow[]
  cells   ReferenceTableCell[]
}

model ReferenceTableColumn {
  tableSlug String
  index     Int
  header    String
  span      Int?
  alignment TextAlignment?

  cells ReferenceTableCell[]
  table ReferenceTable       @relation(fields: [tableSlug], references: [slug])

  @@id([tableSlug, index])
}

model ReferenceTableRow {
  tableSlug String
  index     Int

  cells ReferenceTableCell[]
  table ReferenceTable       @relation(fields: [tableSlug], references: [slug])

  @@id([tableSlug, index])
}

model ReferenceTableCell {
  tableSlug   String
  columnIndex Int
  rowIndex    Int
  value       String? @db.Text
  colSpan     Int?
  rowSpan     Int?

  column ReferenceTableColumn @relation(fields: [tableSlug, columnIndex], references: [tableSlug, index])
  row    ReferenceTableRow    @relation(fields: [tableSlug, rowIndex], references: [tableSlug, index])
  table  ReferenceTable       @relation(fields: [tableSlug], references: [slug])

  @@id([tableSlug, columnIndex, rowIndex])
}

// =================
// Characters
// =================

model Character {
  id          Int     @id @default(autoincrement())
  userId      Int
  name        String
  raceId      Int
  alignmentId Int? // Optional alignment
  deityId     Int? // Optional deity worship
  xp          Int     @default(0)
  age         Int?
  height      Int?
  weight      Int?
  eyes        String?
  hair        String?
  gender      String?
  notes       String? @db.Text

  editionId Int

  abilityScores      CharacterAbilityScore[]
  config             CharacterConfig?
  wealth             CharacterWealth[]
  characterItems     CharacterItem[]
  attackDefinitions  CharacterAttackDefinition[]
  companions         CharacterCompanion[]
  selectedForms      CharacterSelectedForm[]
  advancements       CharacterAdvancement[]
  preparedSpells     CharacterSpellPreparation[]
  disallowedSources  CharacterDisallowedSource[] // NEW: Disallowed sources relationship
  characterLanguages CharacterLanguageMap[]
  featureUses        CharacterFeatureUses[] // NEW: Feature uses tracking

  race  Race   @relation(fields: [raceId], references: [id])
  deity Deity? @relation(fields: [deityId], references: [id])
  user  User   @relation(fields: [userId], references: [id])

  @@map("UserCharacter")
}

model CharacterConfig {
  characterId           Int     @id
  allowVariantClasses   Boolean @default(false) // Allow class variants
  isGestalt             Boolean @default(false) // Gestalt multiclassing
  ignoreLevelAdjustment Boolean @default(false) // Ignore LA for XP calculation
  /// Official 3.0/3.5: max Hit Die at 1st level. Unchecked = roll (or enter) 1st-level HP. Lives on the character until campaign settings exist.
  maxHpAtFirstLevel     Boolean @default(false)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model CharacterWealth {
  id          Int     @id @default(autoincrement())
  characterId Int
  currencyId  Int
  quantity    Int
  value       Int?
  description String? @db.VarChar(255)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
}

model CharacterAbilityScore {
  id          Int @id @default(autoincrement())
  characterId Int
  abilityId   Int
  value       Int

  character Character @relation(fields: [characterId], references: [id])

  @@map("UserCharacterAbilityScore")
}

model CharacterLanguageMap {
  characterId Int
  languageId  Int

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([characterId, languageId])
}

model CharacterAdvancement {
  id               Int      @id @default(autoincrement())
  characterId      Int
  level            Int
  version          Int // Incrementing number per (characterId, level)
  classId          Int
  secondaryClassId Int? // for gestalt/variant multiclassing
  hitPoints        Int
  abilityId        Int?
  notes            String?  @db.Text
  createdAt        DateTime @default(now())

  character      Character     @relation(fields: [characterId], references: [id])
  class          Class         @relation(fields: [classId], references: [id])
  secondaryClass Class?        @relation("SecondaryClass", fields: [secondaryClassId], references: [id])

  skills         AdvancementSkill[]
  feats          AdvancementFeat[]
  spellsKnown    AdvancementSpell[]
  featureChoices CharacterFeatureChoice[]

  @@unique([characterId, level, version])
}

model AdvancementSkill {
  id            Int     @id @default(autoincrement())
  advancementId Int
  skillId       Int
  skillSubId    Int?
  pointsSpent   Int
  customSubtype String? // NEW: For custom subtypes

  advancement CharacterAdvancement @relation(fields: [advancementId], references: [id])
  skill       Skill                @relation(fields: [skillId], references: [id])

  @@unique([advancementId, skillId, skillSubId, customSubtype])
}

model AdvancementFeat {
  advancementId Int
  featId        Int
  featSubId     Int? // For feats with useSubId: true (e.g., Weapon Focus weapon selection)

  advancement CharacterAdvancement @relation(fields: [advancementId], references: [id])
  feat        Feat                 @relation(fields: [featId], references: [id])

  @@id([advancementId, featId])
}

model AdvancementSpell {
  advancementId Int
  spellId       Int
  isFreeGrant   Boolean @default(false)

  advancement CharacterAdvancement @relation(fields: [advancementId], references: [id])
  spell       Spell                @relation(fields: [spellId], references: [id])

  @@id([advancementId, spellId])
}

model CharacterFeatureChoice {
  id                  Int     @id @default(autoincrement())
  characterId         Int
  featureId           Int
  advancementId       Int
  featureEntityId     Int
  appliesToId         Int
  appliesToSubId      Int?
  choiceIndex         Int?
  choiceGroupId       String?
  choiceData          Json?
  linkedChoiceGroupId String?

  feature     Feature                @relation(fields: [featureId], references: [id])
  featureEntity FeatureEntity        @relation(fields: [featureEntityId], references: [id])
  advancement CharacterAdvancement @relation(fields: [advancementId], references: [id])

  @@unique([advancementId, featureId, featureEntityId])
}

model CharacterSpellPreparation {
  id          Int  @id @default(autoincrement())
  characterId Int
  classId     Int // The class whose slot was used
  spellId     Int
  spellLevel  Int // Actual slot level used (post-metamagic)
  quantity    Int // How many times this spell is prepared
  timesCast   Int  @default(0) // How many of the prepared spells have been cast
  slotType    Int  @default(0) // Type of spell slot (0=NORMAL, 1=BONUS, 2=DOMAIN)
  featId      Int? // Metamagic feat applied (if any)

  character Character @relation(fields: [characterId], references: [id])
  class     Class         @relation(fields: [classId], references: [id])
  spell     Spell         @relation(fields: [spellId], references: [id])
  feat      Feat?         @relation(fields: [featId], references: [id])

  @@index([characterId])
}

model CharacterFeatureUses {
  id              Int @id @default(autoincrement())
  characterId     Int
  featureId       Int
  featureEntityId Int
  currentUses     Int @default(0)
  maxUses         Int
  frequency       Int // USES_FREQUENCY_ENUM (PER_DAY, PER_WEEK, PER_LEVEL, PER_ENCOUNTER)

  character     Character @relation(fields: [characterId], references: [id])
  feature       Feature      @relation(fields: [featureId], references: [id])
  featureEntity FeatureEntity @relation(fields: [featureEntityId], references: [id])

  @@unique([characterId, featureId, featureEntityId])
  @@index([characterId])
}

// =================
// User related
// =================

model User {
  id                 Int      @id @default(autoincrement())
  username           String
  email              String
  password           String
  isAdmin            Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  preferredEditionId Int?

  diceConfigBase Int?

  characters          Character[]
  diceConfigOverrides UserDiceConfigOverride[] // NEW: One-to-many relationship

  // NEW: Relation to base config
  diceConfigBaseRef DiceBoxAdminConfig? @relation("UserDiceConfigBase", fields: [diceConfigBase], references: [id])
}

// =================
// DiceBox Admin Configuration
// =================

model DiceBoxAdminConfig {
  id   Int    @id @default(autoincrement())
  name String @default("Default Configuration")

  // NEW: Default flag (only one can be true)
  isDefault Boolean @default(false)

  // Physics properties
  gravity        Float @default(1)
  mass           Float @default(1)
  friction       Float @default(0.8)
  restitution    Float @default(0)
  angularDamping Float @default(0.4)
  linearDamping  Float @default(0.4)
  spinForce      Float @default(4)
  throwForce     Float @default(5)
  startingHeight Int   @default(8)
  settleTimeout  Int   @default(5000)

  // Visual properties
  lightIntensity     Float   @default(1)
  enableShadows      Boolean @default(true)
  shadowTransparency Float   @default(0.8)
  theme              Int     @default(1) // 3D dice theme ID (references DiceTheme enum)
  themeColor         String  @default("#2e8555")
  iconColor          String? // NEW: Separate color for DiceButton icons
  scale              Float   @default(6)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NEW: Relationships
  users User[] @relation("UserDiceConfigBase") // Users who use this as their base config
}

// NEW: User dice configuration overrides
model UserDiceConfigOverride {
  id            Int    @id @default(autoincrement())
  userId        Int
  propertyName  String // e.g., "theme", "themeColor", "scale", "gravity", etc.
  propertyValue String // Stored as string, converted as needed

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyName]) // One override per property per user
}

// =================
// Divine Domains and Deities
// =================

model Domain {
  id        Int     @id @default(autoincrement())
  name      String
  editionId Int
  isVisible Boolean @default(true)

  domainSpells        DomainSpell[]
  deityDomains        DeityDomain[]
  features            Feature[]
  sourceBookInfo      DomainSourceMap[]
  monsters            MonsterDomainMap[]
}

model DomainSpell {
  id         Int @id @default(autoincrement())
  domainId   Int
  spellId    Int
  spellLevel Int // 1-9

  domain Domain @relation(fields: [domainId], references: [id])
  spell  Spell  @relation(fields: [spellId], references: [id])

  @@unique([domainId, spellLevel])
}

model Deity {
  id          Int     @id @default(autoincrement())
  name        String
  title       String?
  alignmentId Int
  isVisible   Boolean @default(true)
  description String? @db.Text
  editionId   Int
  pantheonId  Int?

  domains        DeityDomain[]
  characters     Character[]
  sourceBookInfo DeitySourceMap[]
  deityClasses   DeityClassMap[]
  deityRaces     DeityRaceMap[]
  favoredWeapons DeityFavoredWeaponMap[]
}

model DeityDomain {
  id       Int @id @default(autoincrement())
  deityId  Int
  domainId Int

  deity  Deity  @relation(fields: [deityId], references: [id])
  domain Domain @relation(fields: [domainId], references: [id])

  @@unique([deityId, domainId])
}

model DeityClassMap {
  id      Int @id @default(autoincrement())
  deityId Int
  classId Int

  deity Deity @relation(fields: [deityId], references: [id])
  class Class @relation(fields: [classId], references: [id])

  @@unique([deityId, classId])
}

model DeityFavoredWeaponMap {
  id      Int @id @default(autoincrement())
  deityId Int
  itemId  Int

  deity Deity @relation(fields: [deityId], references: [id])
  item  Item  @relation(fields: [itemId], references: [id])

  @@unique([deityId, itemId])
}

model DeityRaceMap {
  id      Int @id @default(autoincrement())
  deityId Int
  raceId  Int

  deity Deity @relation(fields: [deityId], references: [id])
  race  Race  @relation(fields: [raceId], references: [id])

  @@unique([deityId, raceId])
}

model DomainSourceMap {
  domainId     Int
  sourceBookId Int
  pageNumber   Int?

  domain     Domain     @relation(fields: [domainId], references: [id])
  sourceBook SourceBook @relation(fields: [sourceBookId], references: [id])

  @@id([domainId, sourceBookId])
}

model DeitySourceMap {
  deityId      Int
  sourceBookId Int
  pageNumber   Int?

  deity      Deity      @relation(fields: [deityId], references: [id])
  sourceBook SourceBook @relation(fields: [sourceBookId], references: [id])

  @@id([deityId, sourceBookId])
}

// =================
// Character Disallowed Sources
// =================

model CharacterDisallowedSource {
  id           Int @id @default(autoincrement())
  characterId  Int
  sourceBookId Int

  character  Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  sourceBook SourceBook    @relation(fields: [sourceBookId], references: [id])

  @@unique([characterId, sourceBookId])
}

// =================
// Monster related
// =================

model Monster {
  id            Int     @id @default(autoincrement())
  name          String
  baseMonsterId Int? // Self-referential for variants
  editionId     Int
  isVisible     Boolean @default(true)

  // Descriptive text
  flavorText        String? @db.Text // Italicized intro text
  description       String? @db.Text // Full description
  combatDescription String? @db.Text // Combat behavior text

  // Size (nullable for base monsters)
  sizeId Int?

  // Base speed (land speed, can be 0 for creatures with no land movement)
  baseSpeed Int?

  // AC fields (all nullable)
  armorClass   Int?
  touchAC      Int?
  flatFootedAC Int?

  // Hit Dice (primary set)
  hitDiceQty  Float? // Quantity of hit dice (can be fractional, e.g., 0.5 for 1/2 HD, 0.33 for 1/3 HD)
  hitDiceType Int? // Dice type (references RpgDice enum: D4=0, D6=1, D8=2, D10=3, D12=4, etc.)
  bonusHP     Int? // Bonus hit points
  averageHP   Int? // Average hit points

  // Initiative
  initiative Int?

  // Base Attack/Grapple
  baseAttack Int?
  grapple    Int?

  // Attack and Full Attack (stored as text)
  attack     String? @db.Text
  fullAttack String? @db.Text

  // Space/Reach (in feet)
  space                    Float? // Space occupied in feet (can be fractional, e.g., 2.5 for 2-1/2 ft.)
  reach                    Int? // Reach distance in feet
  optionalReach            Int? // Optional reach for specific attacks (e.g., bite, tentacle)
  optionalReachDescription String? @db.VarChar(100) // Description of optional reach (e.g., "with bite", "with tentacle")

  // Saves (all nullable)
  fortSave Int?
  refSave  Int?
  willSave Int?

  // Abilities (all nullable)
  strength     Int?
  dexterity    Int?
  constitution Int?
  intelligence Int?
  wisdom       Int?
  charisma     Int?

  // Text fields
  organization     String? @db.Text
  treasure         String? @db.Text
  alignment        String? @db.VarChar(100)
  advancement      String? @db.Text
  challengeRating  String? @db.VarChar(100)
  levelAdjustment  String? @db.VarChar(100)
  specialAttacks   String? @db.VarChar(512) // Special Attacks from statblock (may differ from Combat section abilities)
  specialQualities String? @db.VarChar(512) // Special Qualities from statblock (may differ from Combat section abilities)

  // Relationships
  baseMonster         Monster?                        @relation("MonsterVariants", fields: [baseMonsterId], references: [id])
  variants            Monster[]                       @relation("MonsterVariants")
  types               MonsterTypeMap[]
  subtypes            MonsterSubtypeMap[]
  skills              MonsterSkillMap[]
  feats               MonsterFeatMap[]
  specialAbilities    MonsterSpecialAbilityMap[]
  armorBreakdown      MonsterArmorBreakdown[]
  equipment           MonsterEquipment[]
  spells              MonsterSpell[]
  preparedSpellSlots  MonsterPreparedSpellSlots[]
  sourceBookInfo      MonsterSourceMap[]
  extraHitDice        MonsterExtraHitDie[]
  alternateSpeeds     MonsterAlternateSpeed[]
  domains             MonsterDomainMap[]
  extraDescriptions   MonsterExtraDescription[]
  transformationForms TransformationFormEligibility[]
  companions          Companion[]
  characterCompanions CharacterCompanion[]
  selectedForms       CharacterSelectedForm[]
}

model MonsterTypeMap {
  monsterId Int
  typeId    Int

  monster Monster @relation(fields: [monsterId], references: [id], onDelete: Cascade)

  @@id([monsterId, typeId])
}

model MonsterSubtypeMap {
  monsterId Int
  subtypeId Int

  monster Monster @relation(fields: [monsterId], references: [id], onDelete: Cascade)

  @@id([monsterId, subtypeId])
}

model MonsterSkillMap {
  id         Int     @id @default(autoincrement())
  monsterId  Int
  skillId    Int
  skillSubId Int? // For Knowledge, Craft, Perform, Profession skills with subtypes
  ranks      Int?
  notes      String? @db.Text

  monster Monster @relation(fields: [monsterId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id])

  @@unique([monsterId, skillId, skillSubId])
  @@index([monsterId])
}

model MonsterFeatMap {
  id        Int     @id @default(autoincrement())
  monsterId Int
  featId    Int
  notes     String? @db.VarChar(128) // For repeatable feats, stores the parenthetical value (e.g., "illusion" for "Spell Focus (illusion)")

  monster Monster @relation(fields: [monsterId], references: [id], onDelete: Cascade)
  feat    Feat    @relation(fields: [featId], references: [id])

  @@unique([monsterId, featId, notes])
  @@index([monsterId])
}

model MonsterSpecialAbility {
  id                   Int     @id @default(autoincrement())
  name                 String
  description          String? @db.Text // Can contain markdown and be quite large (nullable for spell-like abilities that are just lists of spells)
  abilityType          Int // MonsterSpecialAbilityTypeId enum (Sp=1, Su=2, Ex=3)
  effectiveCasterLevel Int? // Effective caster level for spell-like abilities
  saveAbility          Int? // Ability ID used for save DCs (references AbilityId enum: Str=1, Dex=2, Con=3, Int=4, Wis=5, Cha=6)

  monsters MonsterSpecialAbilityMap[]
  spells   MonsterSpell[]
}

model MonsterSpecialAbilityMap {
  monsterId Int
  abilityId Int

  monster Monster               @relation(fields: [monsterId], references: [id], onDelete: Cascade)
  ability MonsterSpecialAbility @relation(fields: [abilityId], references: [id])

  @@id([monsterId, abilityId])
}

model MonsterArmorBreakdown {
  id              Int     @id @default(autoincrement())
  monsterId       Int
  componentType   Int // MonsterArmorComponentTypeId enum
  value           Int?
  equipmentItemId Int?
  description     String? @db.Text

  monster       Monster @relation(fields: [monsterId], references: [id], onDelete: Cascade)
  equipmentItem Item?   @relation(fields: [equipmentItemId], references: [id])

  @@index([monsterId])
}

model MonsterEquipment {
  monsterId Int
  itemId    Int

  monster Monster @relation(fields: [monsterId], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [itemId], references: [id])

  @@id([monsterId, itemId])
}

model MonsterSpell {
  id               Int     @id @default(autoincrement())
  monsterId        Int
  spellId          Int
  spellType        Int // MonsterSpellTypeId enum
  quantity         Int? // For prepared spells (e.g., "detect magic (2)" = quantity 2)
  usesPerDayId     Int? // MonsterSpellUsesPerDayId enum (nullable for prepared spells, which don't have uses per day)
  saveDC           Int?
  level            Int? // Spell level at which the spell is prepared (for prepared spells only)
  specialAbilityId Int? // Links to MonsterSpecialAbility if this spell is part of a spell-like ability
  notes            String? @db.VarChar(200) // Spell modifiers (e.g., "empowered", "extended", "enlarged")

  monster        Monster                @relation(fields: [monsterId], references: [id], onDelete: Cascade)
  spell          Spell                  @relation(fields: [spellId], references: [id])
  specialAbility MonsterSpecialAbility? @relation(fields: [specialAbilityId], references: [id], onDelete: SetNull)

  @@index([monsterId])
  @@index([specialAbilityId])
}

model MonsterPreparedSpellSlots {
  id         Int @id @default(autoincrement())
  monsterId  Int
  spellLevel Int // Spell level (0-9)
  numSlots   Int // Number of spell slots at this level

  monster Monster @relation(fields: [monsterId], references: [id], onDelete: Cascade)

  @@unique([monsterId, spellLevel])
  @@index([monsterId])
}

model MonsterSourceMap {
  monsterId    Int
  sourceBookId Int
  pageNumber   Int?

  monster    Monster    @relation(fields: [monsterId], references: [id], onDelete: Cascade)
  sourceBook SourceBook @relation(fields: [sourceBookId], references: [id])

  @@id([monsterId, sourceBookId])
}

model MonsterExtraHitDie {
  id          Int   @id @default(autoincrement())
  monsterId   Int
  hitDiceQty  Float // Quantity of hit dice (can be fractional, e.g., 0.5 for 1/2 HD, 0.33 for 1/3 HD)
  hitDiceType Int // Dice type (references RpgDice enum: D4=0, D6=1, D8=2, D10=3, D12=4, etc.)
  bonusHP     Int? // Bonus hit points

  monster Monster @relation(fields: [monsterId], references: [id], onDelete: Cascade)

  @@index([monsterId])
}

model MonsterAlternateSpeed {
  id              Int  @id @default(autoincrement())
  monsterId       Int
  movementTypeId  Int // Movement type (references MovementTypeId enum: Land=1, Fly=2, Swim=3, Climb=4, Burrow=5)
  speed           Int // Speed in feet
  maneuverability Int? // Maneuverability for fly speed (references ManeuverabilityId enum: Perfect=1, Good=2, Average=3, Poor=4, Clumsy=5)

  monster Monster @relation(fields: [monsterId], references: [id], onDelete: Cascade)

  @@index([monsterId])
}

model MonsterDomainMap {
  monsterId Int
  domainId  Int

  monster Monster @relation(fields: [monsterId], references: [id], onDelete: Cascade)
  domain  Domain  @relation(fields: [domainId], references: [id])

  @@id([monsterId, domainId])
  @@index([monsterId])
}

model MonsterExtraDescription {
  id          Int     @id @default(autoincrement())
  monsterId   Int
  type        Int // MonsterExtraDescriptionTypeId enum (mount=1, society=2, character=3, creating=4, tactics=5, sidebar=6, training=7)
  description String? @db.Text

  monster Monster @relation(fields: [monsterId], references: [id], onDelete: Cascade)

  @@index([monsterId])
}

// =================
// Companion related
// =================

model Companion {
  id              Int  @id @default(autoincrement())
  type            Int // CompanionType enum
  monsterId       Int // Link to Monster for base statistics (required)
  minLevel        Int? // Minimum character level required (for Alternative Companions and Improved Familiars)
  levelAdjustment Int? // PHB alternative-list penalty (3 / 6 / 9 / 12 / 15)

  monster             Monster              @relation(fields: [monsterId], references: [id])
  characterCompanions CharacterCompanion[]
  features            Feature[] // Features for companion benefits

  @@unique([type, monsterId, minLevel])
  @@index([type])
  @@index([monsterId])
}

model CharacterCompanion {
  id             Int     @id @default(autoincrement())
  characterId    Int
  monsterId      Int // Direct reference to Monster (not through Companion)
  companionId    Int? // Optional reference to Companion for familiars with benefits
  trickPurposeId Int? // Handle Animal general purpose (at most one)
  name           String? // Player-given name
  levelAcquired  Int?
  hitPoints      Int? // Current/max hit points (defaults to Monster.averageHP, can be rolled)
  wounds         Int     @default(0) // Current damage taken (for combat tracking)

  character    Character                 @relation(fields: [characterId], references: [id], onDelete: Cascade)
  monster      Monster                   @relation(fields: [monsterId], references: [id])
  companion    Companion?                @relation(fields: [companionId], references: [id])
  trickPurpose TrickPurpose?             @relation(fields: [trickPurposeId], references: [id])
  tricks       CharacterCompanionTrick[]
  skills       CharacterCompanionSkill[]
  feats        CharacterCompanionFeat[]

  @@index([characterId])
  @@index([monsterId])
  @@index([companionId])
  @@index([trickPurposeId])
}

model Trick {
  id                 Int     @id @default(autoincrement())
  name               String
  description        String? @db.Text
  editionId          Int
  dc                 Int
  maxTimesTrainable  Int     @default(1) // Attack is 2; others 1
  isVisible          Boolean @default(true)

  characterCompanionTricks CharacterCompanionTrick[]
  purposeTricks            TrickPurposeTrick[]
  sourceBookInfo           TrickSourceMap[]
}

model CharacterCompanionTrick {
  id                   Int     @id @default(autoincrement())
  characterCompanionId Int
  trickId              Int
  timesTrained         Int     @default(1) // Slot cost; 2 = Attack trained vs all creatures
  isBonus              Boolean @default(false) // PHB bonus tricks do not count against Int limit
  fromPurpose          Boolean @default(false) // Granted by the selected general purpose

  characterCompanion CharacterCompanion @relation(fields: [characterCompanionId], references: [id], onDelete: Cascade)
  trick              Trick              @relation(fields: [trickId], references: [id], onDelete: Cascade)

  @@unique([characterCompanionId, trickId])
  @@index([characterCompanionId])
  @@index([trickId])
}

model TrickSourceMap {
  trickId      Int
  sourceBookId Int
  pageNumber   Int?

  trick      Trick      @relation(fields: [trickId], references: [id], onDelete: Cascade)
  sourceBook SourceBook @relation(fields: [sourceBookId], references: [id])

  @@id([trickId, sourceBookId])
}

model TrickPurpose {
  id                Int     @id @default(autoincrement())
  name              String
  description       String? @db.Text
  dc                Int
  trainingWeeks     Int
  editionId         Int
  isVisible         Boolean @default(true)
  replacesPurposeId Int? // e.g. Combat Riding replaces Riding

  replacesPurpose     TrickPurpose?            @relation("TrickPurposeReplacement", fields: [replacesPurposeId], references: [id])
  replacedBy          TrickPurpose[]           @relation("TrickPurposeReplacement")
  tricks              TrickPurposeTrick[]
  characterCompanions CharacterCompanion[]
  sourceBookInfo      TrickPurposeSourceMap[]

  @@index([editionId])
  @@index([replacesPurposeId])
}

model TrickPurposeTrick {
  id           Int @id @default(autoincrement())
  purposeId    Int
  trickId      Int
  timesTrained Int @default(1)

  purpose TrickPurpose @relation(fields: [purposeId], references: [id], onDelete: Cascade)
  trick   Trick        @relation(fields: [trickId], references: [id], onDelete: Cascade)

  @@unique([purposeId, trickId])
  @@index([purposeId])
  @@index([trickId])
}

model TrickPurposeSourceMap {
  trickPurposeId Int
  sourceBookId   Int
  pageNumber     Int?

  trickPurpose TrickPurpose @relation(fields: [trickPurposeId], references: [id], onDelete: Cascade)
  sourceBook   SourceBook   @relation(fields: [sourceBookId], references: [id])

  @@id([trickPurposeId, sourceBookId])
}

model CharacterCompanionSkill {
  id                   Int  @id @default(autoincrement())
  characterCompanionId Int
  skillId              Int
  skillSubId           Int?
  ranks                Int

  characterCompanion CharacterCompanion @relation(fields: [characterCompanionId], references: [id], onDelete: Cascade)
  skill              Skill              @relation(fields: [skillId], references: [id])

  @@unique([characterCompanionId, skillId, skillSubId])
  @@index([characterCompanionId])
  @@index([skillId])
}

model CharacterCompanionFeat {
  id                   Int     @id @default(autoincrement())
  characterCompanionId Int
  featId               Int
  notes                String? @db.VarChar(128)

  characterCompanion CharacterCompanion @relation(fields: [characterCompanionId], references: [id], onDelete: Cascade)
  feat               Feat               @relation(fields: [featId], references: [id])

  @@unique([characterCompanionId, featId, notes])
  @@index([characterCompanionId])
  @@index([featId])
}

model CharacterSelectedForm {
  id         Int @id @default(autoincrement())
  characterId Int
  featureId  Int
  monsterId  Int
  sortOrder  Int @default(0)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  feature   Feature   @relation(fields: [featureId], references: [id], onDelete: Cascade)
  monster   Monster   @relation(fields: [monsterId], references: [id])

  @@unique([characterId, featureId, monsterId])
  @@index([characterId])
  @@index([featureId])
  @@index([monsterId])
}

// =================
// Transformation Form Eligibility
// =================

model TransformationFormEligibility {
  id        Int     @id @default(autoincrement())
  featureId Int
  monsterId Int
  minLevel  Int?
  notes     String? @db.Text

  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  monster Monster @relation(fields: [monsterId], references: [id], onDelete: Cascade)

  @@unique([featureId, monsterId])
  @@index([featureId])
  @@index([monsterId])
}
