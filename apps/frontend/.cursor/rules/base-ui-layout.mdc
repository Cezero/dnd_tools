### Utility Integration
```typescript
// ✅ CORRECT - Use Base UI utilities
// Documentation: https://base-ui.com/react/utils/
import { DirectionProvider, useRender } from '@base-ui-components/react';

const App = () => (
    <DirectionProvider>
        <CharacterSheet />
    </DirectionProvider>
);

const CustomComponent = () => {
    const render = useRender();
    
    return render((props) => (
        <div {...props} className="custom-component">
            Content
        </div>
    ));
};
```

### Styling with Tailwind CSS

#### Theme Integration
```typescript
// ✅ CORRECT - Use design system colors
const themeColors = {
    primary: 'bg-blue-500 hover:bg-blue-600',
    secondary: 'bg-gray-500 hover:bg-gray-600',
    danger: 'bg-red-500 hover:bg-red-600',
    success: 'bg-green-500 hover:bg-green-600',
};

const ThemedButton = ({ variant = 'primary', children }) => (
    <button className={`px-4 py-2 text-white rounded-md ${themeColors[variant]}`}>
        {children}
    </button>
);
```

#### Loading States
```typescript
const LoadingButton = ({ loading, children, ...props }) => (
    <button 
        {...props}
        disabled={loading}
        className="px-4 py-2 bg-blue-500 text-white rounded-md
                   disabled:opacity-50 disabled:cursor-not-allowed"
    >
        {loading ? (
            <div className="flex items-center space-x-2">
                <Spinner className="w-4 h-4" />
                <span>Loading...</span>
            </div>
        ) : children}
    </button>
);
```

### Accessibility Features

#### Automatic Accessibility
- **Base UI handles ARIA attributes** automatically for layout and feedback
- **Keyboard navigation** built into all interactive components
- **Screen reader support** for all components
- **Focus management** handled by components

#### Custom Accessibility
```typescript
// ✅ CORRECT - Maintain accessibility when customizing
const AccessibleDialog = () => (
    <Dialog aria-labelledby="dialog-title" aria-describedby="dialog-description">
        <Dialog.Content>
            <Dialog.Header>
                <Dialog.Title id="dialog-title">Edit Character</Dialog.Title>
                <Dialog.Description id="dialog-description">
                    Make changes to your character here.
                </Dialog.Description>
            </Dialog.Header>
        </Dialog.Content>
    </Dialog>
);
```

