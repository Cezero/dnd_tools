## Base UI Layout and Feedback Components - Usage Patterns

### Layout Components (Use Base UI Directly)
```typescript
// ✅ CORRECT - Use Base UI directly for layout
// Documentation: https://base-ui.com/react/components/scroll-area.md
import { ScrollArea, Separator, Accordion } from '@base-ui-components/react';

const CharacterPanel = () => (
    <div className="h-96">
        <ScrollArea className="h-full">
            <div className="p-4 space-y-4">
                <h2>Character Stats</h2>
                <Separator />
                <Accordion>
                    <Accordion.Item value="stats">
                        <Accordion.Trigger>Base Stats</Accordion.Trigger>
                        <Accordion.Content>
                            <StatsDisplay />
                        </Accordion.Content>
                    </Accordion.Item>
                </Accordion>
            </div>
        </ScrollArea>
    </div>
);
```

### Feedback Components (Use Base UI Directly)
```typescript
// ✅ CORRECT - Use Base UI directly for feedback
// Documentation: https://base-ui.com/react/components/
import { Dialog, Toast, Tooltip, AlertDialog } from '@base-ui-components/react';

const CharacterActions = () => (
    <div>
        <Tooltip content="Delete character permanently">
            <button 
                onClick={() => setShowDeleteDialog(true)}
                className="px-4 py-2 bg-red-500 text-white rounded"
            >
                Delete Character
            </button>
        </Tooltip>
        
        <AlertDialog open={showDeleteDialog} onOpenChange={setShowDeleteDialog}>
            <AlertDialog.Content>
                <AlertDialog.Header>
                    <AlertDialog.Title>Delete Character</AlertDialog.Title>
                    <AlertDialog.Description>
                        This action cannot be undone. This will permanently delete your character.
                    </AlertDialog.Description>
                </AlertDialog.Header>
                <AlertDialog.Footer>
                    <AlertDialog.Cancel>Cancel</AlertDialog.Cancel>
                    <AlertDialog.Action onClick={handleDelete}>Delete</AlertDialog.Action>
                </AlertDialog.Footer>
            </AlertDialog.Content>
        </AlertDialog>
    </div>
);
```

### ScrollArea Usage
```typescript
// ✅ CORRECT - Use ScrollArea for scrollable content
// Documentation: https://base-ui.com/react/components/scroll-area.md
import { ScrollArea } from '@base-ui-components/react';

const ScrollableContent = () => (
    <div className="h-96 border rounded-md">
        <ScrollArea className="h-full">
            <div className="p-4 space-y-4">
                {/* Long content that needs scrolling */}
                {Array.from({ length: 50 }, (_, i) => (
                    <div key={i} className="p-2 bg-gray-100 rounded">
                        Item {i + 1}
                    </div>
                ))}
            </div>
        </ScrollArea>
    </div>
);
```

### Dialog and Modal Patterns
```typescript
// ✅ CORRECT - Dialog implementation with proper structure
import { Dialog } from '@base-ui-components/react';

const CharacterDialog = () => (
    <Dialog open={isOpen} onOpenChange={setIsOpen}>
        <Dialog.Content className="max-w-md">
            <Dialog.Header>
                <Dialog.Title>Edit Character</Dialog.Title>
                <Dialog.Description>
                    Make changes to your character here. Click save when you're done.
                </Dialog.Description>
            </Dialog.Header>
            
            <div className="py-4">
                <CharacterForm />
            </div>
            
            <Dialog.Footer>
                <button 
                    onClick={() => setIsOpen(false)}
                    className="px-4 py-2 text-gray-600 hover:text-gray-800"
                >
                    Cancel
                </button>
                <button 
                    onClick={handleSave}
                    className="px-4 py-2 bg-blue-500 text-white rounded-md hover:bg-blue-600"
                >
                    Save Changes
                </button>
            </Dialog.Footer>
        </Dialog.Content>
    </Dialog>
);
```

### Accordion Implementation
```typescript
// ✅ CORRECT - Accordion with proper content structure
import { Accordion } from '@base-ui-components/react';

const CharacterAccordion = () => (
    <Accordion type="single" collapsible className="w-full">
        <Accordion.Item value="stats">
            <Accordion.Trigger className="px-4 py-2 hover:bg-gray-50">
                Character Stats
            </Accordion.Trigger>
            <Accordion.Content className="px-4 pb-4">
                <StatsDisplay />
            </Accordion.Content>
        </Accordion.Item>
        
        <Accordion.Item value="features">
            <Accordion.Trigger className="px-4 py-2 hover:bg-gray-50">
                Features & Abilities
            </Accordion.Trigger>
            <Accordion.Content className="px-4 pb-4">
                <FeaturesDisplay />
            </Accordion.Content>
        </Accordion.Item>
        
        <Accordion.Item value="inventory">
            <Accordion.Trigger className="px-4 py-2 hover:bg-gray-50">
                Inventory
            </Accordion.Trigger>
            <Accordion.Content className="px-4 pb-4">
                <InventoryDisplay />
            </Accordion.Content>
        </Accordion.Item>
    </Accordion>
);
```

