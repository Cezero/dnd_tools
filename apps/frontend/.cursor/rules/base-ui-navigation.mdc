## Base UI Navigation Components - Usage Patterns and Styling

### Navigation Components (Use Base UI Directly)
```typescript
// ✅ CORRECT - Use Base UI directly for navigation
// Documentation: https://base-ui.com/react/components/navigation-menu.md
import { NavigationMenu, Tabs, Breadcrumb } from '@base-ui-components/react';

const MainNavigation = () => (
    <NavigationMenu>
        <NavigationMenu.Item href="/dashboard">Dashboard</NavigationMenu.Item>
        <NavigationMenu.Item href="/characters">Characters</NavigationMenu.Item>
        <NavigationMenu.Item href="/campaigns">Campaigns</NavigationMenu.Item>
    </NavigationMenu>
);
```

### Tab Navigation
```typescript
// ✅ CORRECT - Tab implementation with proper structure
import { Tabs } from '@base-ui-components/react';

const CharacterTabs = () => (
    <Tabs defaultValue="overview">
        <Tabs.List>
            <Tabs.Trigger value="overview">Overview</Tabs.Trigger>
            <Tabs.Trigger value="stats">Stats</Tabs.Trigger>
            <Tabs.Trigger value="inventory">Inventory</Tabs.Trigger>
        </Tabs.List>
        
        <Tabs.Content value="overview">
            <CharacterOverview />
        </Tabs.Content>
        
        <Tabs.Content value="stats">
            <CharacterStats />
        </Tabs.Content>
        
        <Tabs.Content value="inventory">
            <CharacterInventory />
        </Tabs.Content>
    </Tabs>
);
```

### Menu Navigation
```typescript
// ✅ CORRECT - Menu implementation
import { Menu } from '@base-ui-components/react';

const CharacterMenu = () => (
    <Menu>
        <Menu.Trigger>
            <button className="px-4 py-2 bg-blue-500 text-white rounded">
                Character Actions
            </button>
        </Menu.Trigger>
        
        <Menu.Content>
            <Menu.Item onClick={handleEdit}>Edit Character</Menu.Item>
            <Menu.Item onClick={handleDuplicate}>Duplicate Character</Menu.Item>
            <Menu.Separator />
            <Menu.Item onClick={handleDelete} className="text-red-600">
                Delete Character
            </Menu.Item>
        </Menu.Content>
    </Menu>
);
```

### Menubar Navigation
```typescript
// ✅ CORRECT - Menubar implementation
import { Menubar } from '@base-ui-components/react';

const ApplicationMenubar = () => (
    <Menubar>
        <Menubar.Menu>
            <Menubar.Trigger>File</Menubar.Trigger>
            <Menubar.Content>
                <Menubar.Item onClick={handleNew}>New Character</Menubar.Item>
                <Menubar.Item onClick={handleOpen}>Open Character</Menubar.Item>
                <Menubar.Item onClick={handleSave}>Save Character</Menubar.Item>
            </Menubar.Content>
        </Menubar.Menu>
        
        <Menubar.Menu>
            <Menubar.Trigger>Edit</Menubar.Trigger>
            <Menubar.Content>
                <Menubar.Item onClick={handleUndo}>Undo</Menubar.Item>
                <Menubar.Item onClick={handleRedo}>Redo</Menubar.Item>
            </Menubar.Content>
        </Menubar.Menu>
    </Menubar>
);
```

