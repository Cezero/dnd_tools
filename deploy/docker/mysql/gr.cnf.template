[mysqld]
server-id=${MYSQL_SERVER_ID}
disabled_storage_engines="MyISAM,BLACKHOLE,FEDERATED,ARCHIVE,MEMORY"
gtid_mode=ON
enforce_gtid_consistency=ON
log_bin=binlog
log_replica_updates=ON
binlog_format=ROW
binlog_checksum=NONE
transaction_write_set_extraction=XXHASH64
plugin_load_add='group_replication.so'
loose-group_replication_group_name=${MYSQL_GROUP_NAME}
# ON after the group exists: a single mysqld restart auto-rejoins.
# Keep bootstrap_group=OFF always except a manual full-group recovery.
# start_on_boot cannot recreate a group if all members restart together.
loose-group_replication_start_on_boot=ON
loose-group_replication_local_address="${HOST_IP}:33061"
loose-group_replication_group_seeds="192.168.0.89:33061,192.168.0.90:33061,192.168.0.93:33061"
loose-group_replication_bootstrap_group=OFF
loose-group_replication_ip_allowlist="192.168.0.0/22"
loose-group_replication_single_primary_mode=ON
loose-group_replication_enforce_update_everywhere_checks=OFF
loose-group_replication_recovery_get_public_key=ON
loose-group_replication_autorejoin_tries=8
loose-group_replication_exit_state_action=READ_ONLY
# Default expel is 5s after suspicion; too tight for dock/NFS hiccups.
loose-group_replication_member_expel_timeout=60
report_host=${HOST_IP}
bind-address=0.0.0.0
port=3306
datadir=/var/lib/mysql
socket=/var/run/mysqld/mysqld.sock
max_connect_errors=1000000
skip_name_resolve=ON
