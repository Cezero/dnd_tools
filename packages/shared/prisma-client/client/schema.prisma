generator client {
  provider = "prisma-client-js"
  output   = "../../../packages/shared/prisma-client/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =================
// Class related
// =================

model Class {
  id               Int     @id @default(autoincrement())
  name             String
  abbreviation     String
  editionId        Int?
  isPrestige       Boolean @default(false)
  isVisible        Boolean @default(true)
  canCastSpells    Boolean @default(false)
  spellsKnown      Boolean @default(false)
  hitDie           Int     @default(1)
  description      String? @db.Text
  skillPoints      Int
  castingAbilityId Int?
  castingType      Int?

  babProgression  Int
  fortProgression Int
  refProgression  Int
  willProgression Int

  features                FeatureProgression[]
  sourceBookInfo          ClassSourceMap[]
  spellLevels             SpellLevelMap[]
  charAdvancements        CharacterAdvancement[]
  charAdvSecondary        CharacterAdvancement[]      @relation("SecondaryClass")
  charSpellPrep           CharacterSpellPreparation[]
  spellcastingProgression SpellcastingProgression[]
  classSpellsKnown        SpellcastingProgression[]   @relation("classSpellsKnown")
  variants                ClassVariant[]
  deityClasses            DeityClassMap[]
}

model SpellcastingProgression {
  id                 Int  @id @default(autoincrement())
  classId            Int
  classLevel         Int
  classSpellsKnownId Int?

  class            Class              @relation(fields: [classId], references: [id])
  classSpellsKnown Class?             @relation("classSpellsKnown", fields: [classSpellsKnownId], references: [id])
  slots            SpellcastingSlot[]
  spellcastingLink SpellcastingLink[]
}

model SpellcastingSlot {
  id            Int @id @default(autoincrement())
  progressionId Int
  spellLevel    Int
  slotsPerDay   Int

  progression SpellcastingProgression @relation(fields: [progressionId], references: [id])
}

model SpellcastingLink {
  id                   Int     @id @default(autoincrement())
  featureProgressionId Int     @unique
  progressionId        Int
  inheritedFrom        String?
  levelOffset          Int?

  feature     FeatureProgression      @relation(fields: [featureProgressionId], references: [id])
  progression SpellcastingProgression @relation(fields: [progressionId], references: [id])
}

model ClassSourceMap {
  classId      Int
  pageNumber   Int?
  sourceBookId Int

  class      Class       @relation(fields: [classId], references: [id])
  sourceBook SourceBook? @relation(fields: [sourceBookId], references: [id])

  @@id([classId, sourceBookId])
}

model SpellLevelMap {
  classId   Int
  spellId   Int
  level     Int
  isVisible Boolean @default(true)

  spell Spell @relation(fields: [spellId], references: [id])
  class Class @relation(fields: [classId], references: [id])

  @@id([spellId, classId])
}

// =================
// Class Variant related
// =================

model ClassVariant {
  id           Int     @id // Custom ID: baseClassId * 100000 + variantId
  name         String
  abbreviation String
  baseClassId  Int
  description  String? @db.Text

  // Override fields for class properties
  hitDie          Int?
  skillPoints     Int?
  babProgression  Int?
  fortProgression Int?
  refProgression  Int?
  willProgression Int?

  baseClass                   Class                                    @relation(fields: [baseClassId], references: [id])
  featureProgressionOverrides ClassVariantFeatureProgressionOverride[]
  spellOverrides              ClassVariantSpellOverride[]
  sourceBookInfo              ClassVariantSourceMap[]

  @@unique([name, baseClassId])
}

model ClassVariantFeatureProgressionOverride {
  id                            Int                                             @id @default(autoincrement())
  variantId                     Int
  originalFeatureProgressionId  Int?
  replacementFeatureProgression FeatureProgression[]
  removeEntities                ClassVariantFeatureProgressionRemoveEntityMap[]

  variant                    ClassVariant        @relation(fields: [variantId], references: [id])
  originalFeatureProgression FeatureProgression? @relation("OriginalFeature", fields: [originalFeatureProgressionId], references: [id])
}

model ClassVariantFeatureProgressionRemoveEntityMap {
  classVariantFeatureProgressionOverrideId Int
  featureEntityId                          Int

  classVariantFeatureProgressionOverride ClassVariantFeatureProgressionOverride @relation(fields: [classVariantFeatureProgressionOverrideId], references: [id])

  @@id([classVariantFeatureProgressionOverrideId, featureEntityId])
}

model ClassVariantSpellOverride {
  id        Int @id @default(autoincrement())
  variantId Int
  spellId   Int
  level     Int

  variant ClassVariant @relation(fields: [variantId], references: [id])
  spell   Spell        @relation(fields: [spellId], references: [id])

  @@unique([variantId, spellId, level])
}

model ClassVariantSourceMap {
  variantId    Int
  pageNumber   Int?
  sourceBookId Int

  variant    ClassVariant @relation(fields: [variantId], references: [id])
  sourceBook SourceBook?  @relation(fields: [sourceBookId], references: [id])

  @@id([variantId, sourceBookId])
}

// =================
// Feature related
// =================

model Feature {
  id          Int    @id @default(autoincrement())
  slug        String @unique
  name        String
  description String @db.Text

  progressions  FeatureProgression[]
  prerequisites FeaturePrerequisite[]
}

model FeatureProgression {
  id                Int  @id @default(autoincrement())
  sourceType        Int
  level             Int
  featureId         Int
  classId           Int?
  raceId            Int?
  variantOverrideId Int?
  domainId          Int? // NEW: Reference to domain for domain-granted features

  class                Class?                                  @relation(fields: [classId], references: [id])
  race                 Race?                                   @relation(fields: [raceId], references: [id])
  classVariantOverride ClassVariantFeatureProgressionOverride? @relation(fields: [variantOverrideId], references: [id])
  domain               Domain?                                 @relation(fields: [domainId], references: [id]) // NEW: Domain relationship

  feature                Feature                                  @relation(fields: [featureId], references: [id])
  spellcasting           SpellcastingLink?
  characterFeatureChoice CharacterFeatureChoice[]
  entities               FeatureEntity[]
  originalOverrides      ClassVariantFeatureProgressionOverride[] @relation("OriginalFeature")
}

model FeatureEntity {
  id              Int     @id @default(autoincrement())
  progressionId   Int
  appliesTo       Int
  appliesToId     Int?
  appliesToSubId  Int?
  formulaParamsId Int?
  groupingId      Int     @default(0)
  type            Int
  value           Int?
  bonusType       Int?
  displayInDetail Boolean @default(true)
  filterType      Int?

  featureProgression FeatureProgression       @relation(fields: [progressionId], references: [id])
  conditions         FeatureEntityCondition[]
  formulaParams      FeatureFormulaParams?    @relation(fields: [formulaParamsId], references: [id])
}

model FeatureFormulaParams {
  id                      Int     @id @default(autoincrement())
  formulaId               Int
  interval                Int?
  formulaStartLevel       Int?
  abilityId               Int?
  thresholds              String?
  values                  String?
  includeProgressionLevel Boolean @default(true)

  // Enhanced parameters for complex scaling
  valuesRepresent Int? // ConditionalScalingValueType enum
  cumulative      Boolean @default(false) // Whether values accumulate

  featureEntity FeatureEntity[]
}

model FeatureEntityCondition {
  id              Int @id @default(autoincrement())
  featureEntityId Int
  conditionType   Int
  conditionValue  Int

  featureEntity FeatureEntity @relation(fields: [featureEntityId], references: [id])
}

model FeaturePrerequisite {
  id          Int  @id @default(autoincrement())
  featureId   Int
  type        Int
  appliesToId Int?
  minValue    Int

  feature Feature @relation(fields: [featureId], references: [id])
}

// =================
// Spell info
// =================

model Spell {
  id              Int     @id @default(autoincrement())
  name            String
  summary         String? @db.Text
  description     String? @db.Text
  castingTime     String?
  range           String?
  rangeTypeId     Int?
  rangeValue      String?
  area            String?
  duration        String?
  savingThrow     String?
  spellResistance String?
  editionId       Int
  baseLevel       Int
  effect          String?
  target          String?

  descriptorIds    SpellDescriptorMap[]
  levelMapping     SpellLevelMap[]
  schoolIds        SpellSchoolMap[]
  sourceBookInfo   SpellSourceMap[]
  subSchoolIds     SpellSubschoolMap[]
  componentIds     SpellComponentMap[]
  advSpells        AdvancementSpell[]
  charSpellPrep    CharacterSpellPreparation[]
  variantOverrides ClassVariantSpellOverride[]
  domainSpells     DomainSpell[] // NEW: Domain spell associations
}

model SpellDescriptorMap {
  spellId      Int
  descriptorId Int
  spell        Spell @relation(fields: [spellId], references: [id])

  @@id([spellId, descriptorId])
}

model SpellSchoolMap {
  spellId  Int
  schoolId Int
  spell    Spell @relation(fields: [spellId], references: [id])

  @@id([spellId, schoolId])
}

model SpellSourceMap {
  spellId      Int
  sourceBookId Int
  pageNumber   Int?

  spell      Spell      @relation(fields: [spellId], references: [id])
  sourceBook SourceBook @relation(fields: [sourceBookId], references: [id])

  @@id([spellId, sourceBookId])
}

model SpellSubschoolMap {
  spellId     Int
  subSchoolId Int

  spell Spell @relation(fields: [spellId], references: [id])

  @@id([spellId, subSchoolId])
}

model SpellComponentMap {
  spellId     Int
  componentId Int

  spell Spell @relation(fields: [spellId], references: [id])

  @@id([spellId, componentId])
}

// =================
// Skill Info
// =================

model Skill {
  id                Int      @id @default(autoincrement())
  name              String
  abilityId         Int      @default(1)
  checkDescription  String?  @db.Text
  actionDescription String?  @db.Text
  retryTypeId       Int?
  retryDescription  String?  @db.Text
  specialNotes      String?  @db.Text
  synergyNotes      String?  @db.Text
  untrainedNotes    String?  @db.Text
  affectedByArmor   Boolean  @default(false)
  description       String?  @db.Text
  restrictionNotes  String?  @db.Text
  trainedOnly       Boolean?
  isAnalog          Boolean  @default(false)

  advSkills AdvancementSkill[]
}

// =================
// Feats and related info
// =================

model Feat {
  id            Int      @id @default(autoincrement())
  name          String
  typeId        Int
  description   String?  @db.Text
  benefit       String?  @db.Text
  normalEffect  String?  @db.Text
  specialEffect String?  @db.Text
  prerequisites String?  @db.Text
  repeatable    Boolean?
  fighterBonus  Boolean?

  benefits FeatBenefitMap[]
  prereqs  FeatPrerequisiteMap[]
  advFeat  AdvancementFeat[]

  spellPrepMetamagic SpellPreparationMetamagic[]
}

model FeatBenefitMap {
  featId      Int
  typeId      Int
  referenceId Int?
  amount      Int?
  index       Int

  feat Feat @relation(fields: [featId], references: [id])

  @@id([featId, index])
}

model FeatPrerequisiteMap {
  featId      Int
  typeId      Int
  referenceId Int?
  amount      Int?
  index       Int

  feat Feat @relation(fields: [featId], references: [id])

  @@id([featId, index])
}

// =================
// Race and related info
// =================

model Race {
  id              Int     @id @default(autoincrement())
  name            String
  editionId       Int?
  isVisible       Boolean @default(true)
  description     String? @db.Text
  sizeId          Int     @default(5)
  speed           Int     @default(30)
  favoredClassId  Int     @default(0)
  levelAdjustment Int     @default(0)

  sources            RaceSourceMap[]
  userCharacter      UserCharacter[]
  featureProgression FeatureProgression[]
  deityRaces         DeityRaceMap[]
}

model RaceSourceMap {
  raceId       Int
  sourceBookId Int
  pageNumber   Int?

  race       Race        @relation(fields: [raceId], references: [id])
  sourceBook SourceBook? @relation(fields: [sourceBookId], references: [id])

  @@id([raceId, sourceBookId])
}

// =================
// Mundane Armor, Weapons etc.
// =================

model Item {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String?  @db.Text
  typeId      Int      @default(1)
  cost        Decimal? @db.Decimal(10, 2)
  weight      Decimal? @db.Decimal(5, 2)
  quantity    Int?

  armor  Armor?
  weapon Weapon?

  itemType ItemType @relation(fields: [typeId], references: [id])

  characterItems      CharacterItem[]
  itemTemplate        ItemTemplate[]
  deityFavoredWeapons DeityFavoredWeaponMap[]
}

model ItemType {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(100)

  itemLinks Item[]
}

model Armor {
  id                 Int  @id
  category           Int
  bonus              Int?
  dexterityCap       Int?
  checkPenalty       Int?
  arcaneSpellFailure Int?
  speedCapThirty     Int?
  speedCapTwenty     Int?

  item Item @relation(fields: [id], references: [id], onDelete: Cascade)
}

model Weapon {
  id           Int     @id
  category     Int
  type         Int
  attackBonus  Int?
  damageSmall  String?
  damageMedium String?
  critical     String?
  range        String?
  damageType   String?
  reach        Boolean @default(false)
  double       Boolean @default(false)
  nonlethal    Boolean @default(false)

  item Item @relation(fields: [id], references: [id], onDelete: Cascade)
}

model ItemProperty {
  id                      Int              @id @default(autoincrement())
  name                    String           @db.VarChar(100) // e.g. "Vorpal", "+2 Enhancement"
  type                    ItemPropertyType
  flatCostModifier        Int? // in copper
  costMultiplier          Float? // e.g. 2.0 for Barding
  costFormula             String? // optional expression string
  enhancementBonusValue   Int? // e.g. 2 for "+2"
  bonusEquivalentModifier Int? // e.g. 5 for Vorpal
  exclusiveMaterial       Boolean          @default(false)

  appliesTo               ItemPropertyAppliesTo[]
  incompatibilitiesA      ItemPropertyIncompatibility[] @relation("IncompatibilityA")
  incompatibilitiesB      ItemPropertyIncompatibility[] @relation("IncompatibilityB")
  templateProperties      ItemTemplateProperty[]
  characterItemProperties CharacterItemProperty[]
}

enum ItemPropertyType {
  Material
  Enhancement
  SpecialAbility
  Structural
}

model ItemPropertyAppliesTo {
  id         Int                    @id @default(autoincrement())
  property   ItemProperty           @relation(fields: [propertyId], references: [id])
  propertyId Int
  itemType   ItemApplicableTypeEnum
}

enum ItemApplicableTypeEnum {
  Weapon
  Armor
  Shield
  MountArmor
  Ammunition
}

model ItemPropertyIncompatibility {
  id          Int          @id @default(autoincrement())
  propertyA   ItemProperty @relation("IncompatibilityA", fields: [propertyAId], references: [id])
  propertyAId Int
  propertyB   ItemProperty @relation("IncompatibilityB", fields: [propertyBId], references: [id])
  propertyBId Int
}

model ItemTemplate {
  id     Int    @id @default(autoincrement())
  name   String @db.VarChar(100)
  itemId Int

  item Item @relation(fields: [itemId], references: [id])

  templateProperties ItemTemplateProperty[]
}

model ItemTemplateProperty {
  id         Int @id @default(autoincrement())
  templateId Int
  propertyId Int

  template ItemTemplate @relation(fields: [templateId], references: [id])
  property ItemProperty @relation(fields: [propertyId], references: [id])
}

model CharacterItem {
  id          Int    @id @default(autoincrement())
  name        String // e.g. "Vorpal Dragonbane Longsword"
  quantity    Int?
  characterId Int
  baseItemId  Int

  character UserCharacter @relation(fields: [characterId], references: [id])
  baseItem  Item          @relation(fields: [baseItemId], references: [id])

  characterItemProperties CharacterItemProperty[]
}

model CharacterItemProperty {
  id              Int           @id @default(autoincrement())
  characterItemId Int
  propertyId      Int
  characterItem   CharacterItem @relation(fields: [characterItemId], references: [id])
  property        ItemProperty  @relation(fields: [propertyId], references: [id])
}

// =================
// Source Books
// =================

model SourceBook {
  id           Int       @id @default(autoincrement())
  name         String
  abbreviation String
  releaseDate  DateTime?
  editionId    Int?
  description  String?   @db.Text
  isVisible    Boolean   @default(true)

  classes                    ClassSourceMap[]
  races                      RaceSourceMap[]
  spells                     SpellSourceMap[]
  classVariants              ClassVariantSourceMap[]
  domains                    DomainSourceMap[] // NEW: Domain source references
  deities                    DeitySourceMap[] // NEW: Deity source references
  characterDisallowedSources CharacterDisallowedSource[] // NEW: Character disallowed sources relationship
}

// =================
// Reference Tables
// =================

enum TextAlignment {
  left
  center
  right
}

model ReferenceTable {
  slug        String  @id
  name        String
  description String? @db.Text

  columns ReferenceTableColumn[]
  rows    ReferenceTableRow[]
  cells   ReferenceTableCell[]
}

model ReferenceTableColumn {
  tableSlug String
  index     Int
  header    String
  span      Int?
  alignment TextAlignment?

  cells ReferenceTableCell[]
  table ReferenceTable       @relation(fields: [tableSlug], references: [slug])

  @@id([tableSlug, index])
}

model ReferenceTableRow {
  tableSlug String
  index     Int

  cells ReferenceTableCell[]
  table ReferenceTable       @relation(fields: [tableSlug], references: [slug])

  @@id([tableSlug, index])
}

model ReferenceTableCell {
  tableSlug   String
  columnIndex Int
  rowIndex    Int
  value       String? @db.Text
  colSpan     Int?
  rowSpan     Int?

  column ReferenceTableColumn @relation(fields: [tableSlug, columnIndex], references: [tableSlug, index])
  row    ReferenceTableRow    @relation(fields: [tableSlug, rowIndex], references: [tableSlug, index])
  table  ReferenceTable       @relation(fields: [tableSlug], references: [slug])

  @@id([tableSlug, columnIndex, rowIndex])
}

// =================
// User Characters
// =================

model UserCharacter {
  id          Int     @id @default(autoincrement())
  userId      Int
  name        String
  raceId      Int
  alignmentId Int
  deityId     Int? // Optional deity worship
  xp          Int     @default(0)
  age         Int?
  height      Int?
  weight      Int?
  eyes        String?
  hair        String?
  gender      String?
  notes       String? @db.Text

  // NEW: Character configuration metadata
  editionId             Int? // Character's edition preference
  allowVariantClasses   Boolean @default(false) // Allow class variants
  isGestalt             Boolean @default(false) // Gestalt multiclassing
  ignoreLevelAdjustment Boolean @default(false) // Ignore LA for XP calculation

  abilityScores     UserCharacterAbilityScore[]
  characterItems    CharacterItem[]
  advancements      CharacterAdvancement[]
  preparedSpells    CharacterSpellPreparation[]
  disallowedSources CharacterDisallowedSource[] // NEW: Disallowed sources relationship

  race  Race   @relation(fields: [raceId], references: [id])
  deity Deity? @relation(fields: [deityId], references: [id])
  user  User   @relation(fields: [userId], references: [id])
}

model UserCharacterAbilityScore {
  id          Int @id @default(autoincrement())
  characterId Int
  abilityId   Int
  value       Int

  character UserCharacter @relation(fields: [characterId], references: [id])
}

model CharacterAdvancement {
  id               Int      @id @default(autoincrement())
  characterId      Int
  level            Int
  version          Int // Incrementing number per (characterId, level)
  classId          Int
  secondaryClassId Int? // for gestalt/variant multiclassing
  hitPoints        Int
  abilityId        Int?
  notes            String?  @db.Text
  createdAt        DateTime @default(now())

  character      UserCharacter @relation(fields: [characterId], references: [id])
  class          Class         @relation(fields: [classId], references: [id])
  secondaryClass Class?        @relation("SecondaryClass", fields: [secondaryClassId], references: [id])

  skills         AdvancementSkill[]
  feats          AdvancementFeat[]
  spellsKnown    AdvancementSpell[]
  featureChoices CharacterFeatureChoice[]

  @@unique([characterId, level, version])
}

model AdvancementSkill {
  advancementId Int
  skillId       Int
  skillSubId    Int?
  pointsSpent   Int
  customSubtype String? // NEW: For custom subtypes

  advancement CharacterAdvancement @relation(fields: [advancementId], references: [id])
  skill       Skill                @relation(fields: [skillId], references: [id])

  @@id([advancementId, skillId])
}

model AdvancementFeat {
  advancementId Int
  featId        Int

  advancement CharacterAdvancement @relation(fields: [advancementId], references: [id])
  feat        Feat                 @relation(fields: [featId], references: [id])

  @@id([advancementId, featId])
}

model AdvancementSpell {
  advancementId Int
  spellId       Int

  advancement CharacterAdvancement @relation(fields: [advancementId], references: [id])
  spell       Spell                @relation(fields: [spellId], references: [id])

  @@id([advancementId, spellId])
}

model CharacterFeatureChoice {
  id            Int     @id @default(autoincrement())
  characterId   Int
  progressionId Int
  advancementId Int
  key           String? // these will likely be replaced with specific identifiers
  value         String? // these will likely be replaced with specific identifiers
  choiceIndex   Int?

  featureProgression FeatureProgression   @relation(fields: [progressionId], references: [id])
  advancement        CharacterAdvancement @relation(fields: [advancementId], references: [id])

  @@unique([advancementId, progressionId, key])
}

model CharacterSpellPreparation {
  characterId   Int
  classId       Int // The class whose slot was used
  spellId       Int
  spellLevel    Int // Actual slot level used (post-metamagic)
  quantity      Int
  prepKey       String // Unique identifier for this exact combination
  slotType      Int     @default(1)
  isDomainSpell Boolean @default(false) // NEW: Is this a domain spell?
  domainId      Int? // NEW: Which domain (if domain spell)

  character  UserCharacter               @relation(fields: [characterId], references: [id])
  class      Class                       @relation(fields: [classId], references: [id])
  spell      Spell                       @relation(fields: [spellId], references: [id])
  domain     Domain?                     @relation(fields: [domainId], references: [id]) // NEW: Domain relationship
  metamagics SpellPreparationMetamagic[]

  @@id([characterId, prepKey])
}

model SpellPreparationMetamagic {
  characterId Int
  prepKey     String
  featId      Int

  feat        Feat                      @relation(fields: [featId], references: [id])
  preparation CharacterSpellPreparation @relation(fields: [characterId, prepKey], references: [characterId, prepKey])

  @@id([characterId, prepKey, featId])
}

// =================
// User related
// =================

model User {
  id                 Int      @id @default(autoincrement())
  username           String
  email              String
  password           String
  isAdmin            Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  preferredEditionId Int?

  // NEW: Reference to admin dice config (replaces old dice fields)
  diceConfigBase Int? // References DiceBoxAdminConfig.id

  // REMOVE: Old dice fields
  // diceTheme          String?  @default("rock")
  // diceThemeColor     String?  @default("#3937b8")
  // diceScale          Int?     @default(3)

  characters          UserCharacter[]
  diceConfigOverrides UserDiceConfigOverride[] // NEW: One-to-many relationship

  // NEW: Relation to base config
  diceConfigBaseRef DiceBoxAdminConfig? @relation("UserDiceConfigBase", fields: [diceConfigBase], references: [id])
}

// =================
// DiceBox Admin Configuration
// =================

model DiceBoxAdminConfig {
  id   Int    @id @default(autoincrement())
  name String @default("Default Configuration")

  // NEW: Default flag (only one can be true)
  isDefault Boolean @default(false)

  // Physics properties
  gravity        Float @default(1)
  mass           Float @default(1)
  friction       Float @default(0.8)
  restitution    Float @default(0)
  angularDamping Float @default(0.4)
  linearDamping  Float @default(0.4)
  spinForce      Float @default(4)
  throwForce     Float @default(5)
  startingHeight Int   @default(8)
  settleTimeout  Int   @default(5000)

  // Visual properties
  lightIntensity     Float   @default(1)
  enableShadows      Boolean @default(true)
  shadowTransparency Float   @default(0.8)
  theme              Int     @default(1) // 3D dice theme ID (references DiceTheme enum)
  themeColor         String  @default("#2e8555")
  iconColor          String? // NEW: Separate color for DiceButton icons
  scale              Float   @default(6)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NEW: Relationships
  users User[] @relation("UserDiceConfigBase") // Users who use this as their base config
}

// NEW: User dice configuration overrides
model UserDiceConfigOverride {
  id            Int    @id @default(autoincrement())
  userId        Int
  propertyName  String // e.g., "theme", "themeColor", "scale", "gravity", etc.
  propertyValue String // Stored as string, converted as needed

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyName]) // One override per property per user
}

// =================
// Divine Domains and Deities
// =================

model Domain {
  id        Int    @id @default(autoincrement())
  name      String
  editionId Int

  domainSpells               DomainSpell[]
  deityDomains               DeityDomain[]
  featureProgressions        FeatureProgression[]
  sourceBookInfo             DomainSourceMap[]
  characterSpellPreparations CharacterSpellPreparation[]
}

model DomainSpell {
  id         Int @id @default(autoincrement())
  domainId   Int
  spellId    Int
  spellLevel Int // 1-9

  domain Domain @relation(fields: [domainId], references: [id])
  spell  Spell  @relation(fields: [spellId], references: [id])

  @@unique([domainId, spellLevel])
}

model Deity {
  id          Int     @id @default(autoincrement())
  name        String
  title       String?
  alignmentId Int
  description String? @db.Text
  editionId   Int
  pantheonId  Int?

  domains        DeityDomain[]
  characters     UserCharacter[]
  sourceBookInfo DeitySourceMap[]
  deityClasses   DeityClassMap[]
  deityRaces     DeityRaceMap[]
  favoredWeapons DeityFavoredWeaponMap[]
}

model DeityDomain {
  id       Int @id @default(autoincrement())
  deityId  Int
  domainId Int

  deity  Deity  @relation(fields: [deityId], references: [id])
  domain Domain @relation(fields: [domainId], references: [id])

  @@unique([deityId, domainId])
}

model DeityClassMap {
  id      Int @id @default(autoincrement())
  deityId Int
  classId Int

  deity Deity @relation(fields: [deityId], references: [id])
  class Class @relation(fields: [classId], references: [id])

  @@unique([deityId, classId])
}

model DeityFavoredWeaponMap {
  id      Int @id @default(autoincrement())
  deityId Int
  itemId  Int

  deity Deity @relation(fields: [deityId], references: [id])
  item  Item  @relation(fields: [itemId], references: [id])

  @@unique([deityId, itemId])
}

model DeityRaceMap {
  id      Int @id @default(autoincrement())
  deityId Int
  raceId  Int

  deity Deity @relation(fields: [deityId], references: [id])
  race  Race  @relation(fields: [raceId], references: [id])

  @@unique([deityId, raceId])
}

model DomainSourceMap {
  domainId     Int
  sourceBookId Int
  pageNumber   Int?

  domain     Domain     @relation(fields: [domainId], references: [id])
  sourceBook SourceBook @relation(fields: [sourceBookId], references: [id])

  @@id([domainId, sourceBookId])
}

model DeitySourceMap {
  deityId      Int
  sourceBookId Int
  pageNumber   Int?

  deity      Deity      @relation(fields: [deityId], references: [id])
  sourceBook SourceBook @relation(fields: [sourceBookId], references: [id])

  @@id([deityId, sourceBookId])
}

// =================
// Character Disallowed Sources
// =================

model CharacterDisallowedSource {
  id           Int @id @default(autoincrement())
  characterId  Int
  sourceBookId Int

  character  UserCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
  sourceBook SourceBook    @relation(fields: [sourceBookId], references: [id])

  @@unique([characterId, sourceBookId])
}
